generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id               String    @id @default(cuid())
  studentName      String
  email            String?
  phone            String
  course           String?
  preferredContact String?
  experience       String?
  message          String?   @db.Text
  status           String    @default("New")
  consent          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  level         String?
  description   String?  @db.Text
  icon          String?
  audience      String?
  prerequisites String?
  duration      String?
  price         String?
  image         String?
  skills        String   @db.Text // JSON array serialized as string, e.g. ["skill1","skill2"]
  syllabus      String?  @db.Text // JSON array serialized: [{ title, duration, description, lessons, labMilestone }]
  published     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model TrainingGallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LibraryResource {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  category      String
  description   String?  @db.Text
  format        String?  // "Video Masterclass", "Technical Repair Manual", "Schematic & Circuit Handbook", "Quick Reference Guide"
  level         String?  // "Beginner", "Intermediate", "Advanced", "All Skill Levels"
  status        String   @default("Available") // "Available", "Coming Soon", "Draft"
  price         String?  // e.g. "850 ETB"
  priceETB      Int      @default(0) // Numeric value e.g. 850
  pages         String?  // e.g. "142 Pages" or "18 Lessons"
  fileUrl       String?  @db.Text
  thumbnailUrl  String?  @db.Text
  instructor    String?  // e.g. "Master Tech Haile"
  instructorRole String? // e.g. "Lead Diagnostic Instructor"
  rating        Float    @default(4.9)
  reviewCount   Int      @default(100)
  badgeText     String?  // e.g. "Bestseller Video Masterclass"
  skillsLearned String?  @db.Text // JSON array serialized
  lessons       String?  @db.Text // JSON array of lessons
  chapters      String?  @db.Text // JSON array of chapters
  published     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([published])
}

model AdminUser {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String?
  password  String
  role      String         @default("editor")
  avatarUrl String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id       String   @id @default(cuid())
  key      String
  failedAt DateTime @default(now())

  @@index([key, failedAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Instructor {
  id          String   @id @default(cuid())
  name        String
  role        String
  experience  String?
  bio         String?  @db.Text
  specialties String   @db.Text // JSON array serialized as string, e.g. ["Micro-soldering","Diagnostics"]
  image       String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

model WorkshopFacility {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  icon        String?
  image       String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

model StudentProject {
  id                String   @id @default(cuid())
  title             String
  category          String?
  device            String?
  fault             String?  @db.Text
  diagnosticProcess String?  @db.Text
  solution          String?  @db.Text
  outcome           String?  @db.Text
  technician        String?
  badge             String?
  image             String?
  published         Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model Registration {
  id                 String    @id @default(cuid())
  registrationNumber String    @unique
  fullName           String
  phone              String
  email              String?
  telegramUsername   String?
  city               String?
  courseTitle        String
  shift              String
  education          String?
  experienceYears    String?
  paymentPlan        String    @default("full")
  paymentMethod      String    @default("telebirr")
  basePrice          Int       @default(2999)
  discount           Int       @default(0)
  finalPrice         Int       @default(2999)
  couponCode         String?
  transactionRef     String?
  receiptUrl         String?   @db.Text
  confirmationLink   String?   @db.Text
  status             String    @default("Pending") // 'Pending', 'Approved', 'Rejected', 'Enrolled'
  adminNotes         String?   @db.Text
  approvedAt         DateTime?
  approvedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentId          String?
  student            Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  institutionalEmail String?
  batchId            String?
  batch              Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([registrationNumber])
  @@index([studentId])
  @@index([institutionalEmail])
  @@index([batchId])
}

model Student {
  id                 String           @id @default(cuid())
  studentId          String           @unique // e.g. STU-26-8921
  fullName           String
  institutionalEmail String           @unique // e.g. lealem.meseret@hellotvet.edu.et
  personalEmail      String?
  phone              String
  telegramUsername   String?
  password           String           // bcrypt hash
  city               String?
  avatarUrl          String?
  status             String           @default("Active") // 'Active', 'Suspended'
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  registrations      Registration[]
  sessions           StudentSession[]
  digitalPurchases   DigitalPurchase[]

  @@index([phone])
  @@index([institutionalEmail])
}

model StudentSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([expiresAt])
}

model CompanyInquiry {
  id              String   @id @default(cuid())
  companyName     String
  institutionType String   // "Hospital & Healthcare", "Industrial & Manufacturing", "University & Higher Ed", "Telecom & IT", "Banking & Finance", "Government & NGO", "Other"
  contactPerson   String
  jobTitle        String?
  email           String
  phone           String
  employeeCount   String?  // e.g. "1-5 staff", "6-15 staff", "16-30 staff", "30+ staff"
  trainingFocus   String?  // e.g. "Medical Equipment Electronics", "Industrial Boards & Automation", "Hardware & Server Diagnostics", "Micro-soldering & SMT", "Customized Curriculum"
  location        String?  // "On-site at our facility", "At HelloSchool Campus (Bahir Dar)", "Hybrid"
  message         String?  @db.Text
  status          String   @default("New") // "New", "Contacted", "Proposal Sent", "In Discussion", "Converted", "Archived"
  adminNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([institutionType])
}

model TrustedPartner {
  id          String   @id @default(cuid())
  name        String
  category    String?  // "Hospital", "University", "Industry", "Telecom / IT", "Enterprise"
  logoUrl     String   @db.Text
  websiteUrl  String?
  description String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

model Batch {
  id                   String         @id @default(cuid())
  batchNumber          String         @unique // e.g. "Batch 01", "Batch 02", "Batch 12"
  title                String         // e.g. "October 2026 Intake - Practical TVET Cohort"
  description          String?        @db.Text
  startDate            DateTime?
  endDate              DateTime?
  registrationDeadline DateTime?
  status               String         @default("Open") // 'Open' (Enrolling), 'Active' (In Training), 'Completed', 'Upcoming' (Opening Soon)
  capacity             Int            @default(60) // Target enrollment capacity across all courses
  campus               String         @default("Bahir Dar Campus")
  notes                String?        @db.Text
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  registrations        Registration[]

  @@index([status])
  @@index([sortOrder])
}

model DigitalPurchase {
  id               String   @id @default(cuid())
  studentId        String
  resourceId       String   // e.g. "course-1", "manual-1", "manual-2"
  resourceType     String   // "video_course" | "manual" | "book" | "reference"
  title            String
  amount           Int      @default(0) // in ETB
  paymentMethod    String   @default("telebirr") // "telebirr" | "cbe" | "included_in_tvet"
  transactionRef   String?
  status           String   @default("Active") // 'Active', 'Pending'
  progress         Int      @default(0) // 0 to 100%
  completedLessons String?  @db.Text // JSON array of completed lesson IDs e.g. ["l1","l2"]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@index([studentId])
  @@index([resourceId])
  @@index([status])
}


